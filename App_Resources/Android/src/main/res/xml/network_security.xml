<?xml version="1.0" encoding="utf-8"?>
<!-- Release (REBUILD_PLAN §9.1): plain http:// to any host, like the legacy app.
     Each location's service address is typed in Settings, so no host list is built in. -->
<network-security-config>
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
